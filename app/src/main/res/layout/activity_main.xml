<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- ============ top bar ============ -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/txtTitle"
            style="@style/SdrTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/app_name" />

        <!-- clock + battery, right after the title -->
        <LinearLayout
            android:id="@+id/panelClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_toEndOf="@id/txtTitle"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/txtClock"
                style="@style/SdrClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm" />

            <TextView
                android:id="@+id/txtBattery"
                style="@style/SdrClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/text_dim" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConnect"
            style="@style/SdrButton.Accent.Compact"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/connect" />

        <Button
            android:id="@+id/btnRecord"
            style="@style/SdrButton.Compact"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/btnConnect"
            android:text="@string/record" />

        <!-- self-update: always visible, unlike the bottom of the scrollable rail -->
        <Button
            android:id="@+id/btnUpdate"
            style="@style/SdrButton.Compact"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/btnRecord"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/update_icon"
            android:textSize="13sp" />

        <!-- pause freezes the picture, clear wipes every trace -->
        <Button
            android:id="@+id/btnPause"
            style="@style/SdrButton.Compact"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/btnUpdate"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/pause_icon"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnClear"
            style="@style/SdrButton.Compact"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/btnPause"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/clear_icon"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtRecord"
            style="@style/SdrStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/btnClear"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/txtStatus"
            style="@style/SdrStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/panelClock"
            android:layout_toStartOf="@id/txtRecord"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/status_idle" />
    </RelativeLayout>

    <!-- ============ content: rail + spectrum ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- one option per row: label left, control right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/mode" />

                    <Spinner
                        android:id="@+id/spMode"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- data source: real board over USB, or synthesised frames for desk testing -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/source" />

                    <Spinner
                        android:id="@+id/spSource"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- channel preset: live modes only -->
                <LinearLayout
                    android:id="@+id/rowPreset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/preset" />

                    <Spinner
                        android:id="@+id/spPreset"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- previous / next channel, aligned under the preset box -->
                <LinearLayout
                    android:id="@+id/rowPresetNav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPrevPreset"
                        style="@style/SdrButton.Compact"
                        android:layout_width="40dp"
                        android:layout_height="24dp"
                        android:text="@string/channel_prev" />

                    <Button
                        android:id="@+id/btnNextPreset"
                        style="@style/SdrButton.Compact"
                        android:layout_width="40dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:text="@string/channel_next" />
                </LinearLayout>

                <!-- centre frequency: live modes only -->
                <LinearLayout
                    android:id="@+id/rowFreq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/freq_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/editFreq"
                            style="@style/SdrEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/freq_hint"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:text="2437" />

                        <Button
                            android:id="@+id/btnTune"
                            style="@style/SdrButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/tune" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/rate" />

                    <Spinner
                        android:id="@+id/spRate"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- capture wire format: 8-bit CAP16 or 10-bit CAP20 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/bits_row" />

                    <Spinner
                        android:id="@+id/spBits"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- per-frame DC removal: off keeps the LO leak visible at bin 0 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/dc_row" />

                    <Spinner
                        android:id="@+id/spDc"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- where the spectrum comes from: phone-side FFT of a burst capture,
                     or the chip's own SPEC streamer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/cap_row" />

                    <Spinner
                        android:id="@+id/spCap"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/fft" />

                    <Spinner
                        android:id="@+id/spFft"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/bandwidth" />

                    <Spinner
                        android:id="@+id/spBw"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- LO offset: live modes only -->
                <LinearLayout
                    android:id="@+id/rowLo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/lo_offset" />

                    <Spinner
                        android:id="@+id/spLo"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- vertical axis: Auto or a fixed floor with a selectable span -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/axis_floor" />

                    <Spinner
                        android:id="@+id/spFloor"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/axis_span" />

                    <Spinner
                        android:id="@+id/spSpan"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- exponential trace averaging across frames -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/trace_avg" />

                    <Spinner
                        android:id="@+id/spAvg"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/gain" />

                    <TextView
                        android:id="@+id/txtGain"
                        style="@style/SdrValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40" />

                    <!-- hardware AGC: a checked box sends GAIN HARDWARE, the slider is ignored -->
                    <CheckBox
                        android:id="@+id/chkAgc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="@string/agc"
                        android:textColor="@color/text_dim"
                        android:textSize="9sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekGain"
                    style="@style/SdrSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:max="79"
                    android:progress="40" />

                <!-- language: English / 中文, defaults to the system locale -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/language" />

                    <Spinner
                        android:id="@+id/spLang"
                        style="@style/SdrSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:saveEnabled="false" />
                </LinearLayout>

                <!-- GPIO panel: Z/0/1 per pin, only while a board is connected -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SdrLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/gpio_title" />

                    <Button
                        android:id="@+id/btnGpio"
                        style="@style/SdrButton.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:text="@string/gpio_open" />
                </LinearLayout>

                <!-- author credit, tapping it opens the project page -->
                <TextView
                    android:id="@+id/txtAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/author"
                    android:textColor="@color/text_dim"
                    android:textSize="8sp" />
            </LinearLayout>
        </ScrollView>

        <io.github.sd1471123.sdr.SpectrumView
            android:id="@+id/spectrum"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>
